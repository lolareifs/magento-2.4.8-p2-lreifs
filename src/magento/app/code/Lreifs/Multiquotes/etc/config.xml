<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <multiquotes>
            <!-- General Settings Defaults -->
                <general>
                    <enabled>1</enabled>
                </general>
            
            <!-- Rate Limiting Defaults -->
            <rate_limiting>
                <enabled>1</enabled>
                <requests_per_hour>100</requests_per_hour>
            </rate_limiting>
            
            <!-- Quote Settings Defaults - Removed non-implemented configurations -->
            
            <!-- Advanced Settings Defaults -->
            <!-- advanced removed for minimal config -->
        </multiquotes>
        
        <lreifs_multiquotes>
            <!-- Expiration Settings Defaults -->
            <expiration>
                <cron_enabled>1</cron_enabled>
                <batch_size>100</batch_size>
                <max_execution_time>300</max_execution_time>
            </expiration>
        </lreifs_multiquotes>
    </default>
</config>
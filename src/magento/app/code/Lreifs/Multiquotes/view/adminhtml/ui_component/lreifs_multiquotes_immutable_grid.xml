<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">lreifs_multiquotes_immutable_grid.lreifs_multiquotes_immutable_grid_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Immutable Quote</label>
            </button>
        </buttons>
        <spinner>lreifs_multiquotes_immutable_grid_columns</spinner>
        <deps>
            <dep>lreifs_multiquotes_immutable_grid.lreifs_multiquotes_immutable_grid_data_source</dep>
        </deps>
    </settings>
    <dataSource name="lreifs_multiquotes_immutable_grid_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Lreifs_Multiquotes::immutable_quotes</aclResource>
        <dataProvider class="Lreifs\Multiquotes\Ui\Component\Listing\DataProvider\ImmutableQuotes" name="lreifs_multiquotes_immutable_grid_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters">
            <settings>
                <templates>
                    <filters>
                        <select>
                            <param name="template" xsi:type="string">ui/grid/filters/elements/ui-select</param>
                            <param name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</param>
                        </select>
                    </filters>
                </templates>
            </settings>
            <filterSelect name="is_active" provider="${ $.parentName }">
                <settings>
                    <captionValue>0</captionValue>
                    <options class="Lreifs\Multiquotes\Model\Config\Source\IsActive"/>
                    <caption translate="true">Select...</caption>
                    <label translate="true">Is Active</label>
                    <dataScope>is_active</dataScope>
                    <imports>
                        <link name="visible">componentType = column, index = ${ $.index }:visible</link>
                    </imports>
                </settings>
            </filterSelect>
            <filterSelect name="status" provider="${ $.parentName }">
                <settings>
                    <captionValue>0</captionValue>
                    <options class="Lreifs\Multiquotes\Model\Source\Status"/>
                    <caption translate="true">Select...</caption>
                    <label translate="true">Status</label>
                    <dataScope>status</dataScope>
                    <imports>
                        <link name="visible">componentType = column, index = ${ $.index }:visible</link>
                    </imports>
                </settings>
            </filterSelect>
        </filters>
        <massaction name="listing_massaction" component="Magento_Ui/js/grid/tree-massactions">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete selected items?</message>
                        <title translate="true">Delete items</title>
                    </confirm>
                    <url path="multiquotes/immutable/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="lreifs_multiquotes_immutable_grid_columns">
        <settings>
            <!-- EditorConfig removed to disable grid editing -->
        </settings>
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id" sortOrder="100">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="quote_id" sortOrder="200">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Quote ID</label>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="300">
            <settings>
                <options class="Lreifs\Multiquotes\Model\Config\Source\IsActive"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Is Active</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="400">
            <settings>
                <options class="Lreifs\Multiquotes\Model\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="customer_name" class="Lreifs\Multiquotes\Ui\Component\Listing\Column\CustomerName" sortOrder="500">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer</label>
            </settings>
        </column>
        <column name="expires_at" class="Lreifs\Multiquotes\Ui\Component\Listing\Column\ExpiresAt" sortOrder="600">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Expires At</label>
            </settings>
        </column>
        <column name="created_at" component="Magento_Ui/js/grid/columns/date" sortOrder="700">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
            </settings>
        </column>
        <column name="updated_at" component="Magento_Ui/js/grid/columns/date" sortOrder="800">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated At</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Lreifs\Multiquotes\Ui\Component\Listing\Column\ImmutableActions" sortOrder="900">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
<?php
/**
 * @var $block \Lreifs\Multiquotes\Block\Adminhtml\Quotes\View
 * @var $quoteExtension \Lreifs\Multiquotes\Api\Data\QuoteExtensionInterface
 * @var $quote \Magento\Quote\Api\Data\CartInterface
 * @var $customer \Magento\Customer\Api\Data\CustomerInterface
 */

$quoteExtension = $block->getQuoteExtension();
$quote = $block->getQuote();
$customer = $block->getCustomer();

if (!$quoteExtension) {
    echo '<div class="message message-error error"><div class="message-inner"><div class="message-content">' . __('Quote extension not found.') . '</div></div></div>';
    return;
}
?>

<div class="page-main-actions">
    <div class="page-actions-buttons">
        <button onclick="setLocation('<?= $block->escapeUrl($block->getBackUrl()) ?>')" 
                class="back" type="button">
            <span><?= $block->escapeHtml(__('Back')) ?></span>
        </button>
        <?php
        // Check if quote is expired
        $isExpired = false;
        if ($quoteExtension->getExpiresAt()) {
            try {
                $expirationDate = new \DateTime($quoteExtension->getExpiresAt());
                $currentDate = new \DateTime();
                $isExpired = $expirationDate < $currentDate;
            } catch (\Exception $e) {
                $isExpired = false;
            }
        }
        ?>
        
        <?php if ($quoteExtension->getStatus() !== 'converted' && !$quoteExtension->getIsImmutable() && !$isExpired): ?>
        <button onclick="setLocation('<?= $block->escapeUrl($block->getEditUrl()) ?>')" 
                class="edit primary" type="button">
            <span><?= $block->escapeHtml(__('Edit')) ?></span>
        </button>
        <?php endif; ?>
        
        <?php if ($isExpired): ?>
        <button class="action-default disabled" type="button" disabled>
            <span><?= $block->escapeHtml(__('Edit (Expired)')) ?></span>
        </button>
        <button class="action-default disabled" type="button" disabled style="background: #f39800; color: white;">
            <span><?= $block->escapeHtml(__('⚠ Quote Expired')) ?></span>
        </button>
        <?php endif; ?>
        
        <?php if ($quoteExtension->getIsImmutable()): ?>
        <button class="action-default disabled" type="button" disabled>
            <span><?= $block->escapeHtml(__('Edit (Immutable)')) ?></span>
        </button>
        <button class="action-default disabled" type="button" disabled style="background: #666; color: white;">
            <span><?= $block->escapeHtml(__('🔒 Immutable')) ?></span>
        </button>
        <?php endif; ?>
    </div>
</div>

<div class="admin__page-section">
    <div class="admin__page-section-title">
        <span class="title"><?= $block->escapeHtml(__('Quote Extension Information')) ?></span>
    </div>
    <div class="admin__page-section-content">
        <div class="admin__page-section-item quote-extension-information">
            <div class="admin__page-section-item-title">
                <span class="title"><?= $block->escapeHtml(__('General Information')) ?></span>
            </div>
            <div class="admin__page-section-item-content">
                <table class="admin__table-secondary">
                    <tr>
                        <th><?= $block->escapeHtml(__('Extension ID')) ?></th>
                        <td><?= $block->escapeHtml($quoteExtension->getEntityId()) ?></td>
                    </tr>
                    <tr>
                        <th><?= $block->escapeHtml(__('Quote ID')) ?></th>
                        <td><?= $block->escapeHtml($quoteExtension->getQuoteId()) ?></td>
                    </tr>
                    <tr>
                        <th><?= $block->escapeHtml(__('Status')) ?></th>
                        <td>
                            <?php
                            $statusLabels = [
                                'active' => __('Active'),
                                'inactive' => __('Inactive'),
                                'expired' => __('Expired'),
                                'converted' => __('Converted')
                            ];
                            $statusClass = [
                                'active' => 'grid-severity-notice',
                                'inactive' => 'grid-severity-minor',
                                'expired' => 'grid-severity-critical',
                                'converted' => 'grid-severity-notice'
                            ];
                            $status = $quoteExtension->getStatus();
                            if ($status === 'draft') {
                                $status = 'inactive';
                            }
                            ?>
                            <span class="<?= $statusClass[$status] ?? 'grid-severity-minor' ?>">
                                <span><?= $block->escapeHtml($statusLabels[$status] ?? ucfirst($status)) ?></span>
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th><?= $block->escapeHtml(__('Is Immutable')) ?></th>
                        <td>
                            <?php if ($quoteExtension->getIsImmutable()): ?>
                                <span class="grid-severity-critical"><span><?= $block->escapeHtml(__('Yes')) ?></span></span>
                            <?php else: ?>
                                <span class="grid-severity-notice"><span><?= $block->escapeHtml(__('No')) ?></span></span>
                            <?php endif; ?>
                        </td>
                    </tr>
                    <?php if ($quoteExtension->getLockedAt()): ?>
                    <tr>
                        <th><?= $block->escapeHtml(__('Locked At')) ?></th>
                        <td><?= $block->escapeHtml($block->formatDate($quoteExtension->getLockedAt(), \IntlDateFormatter::MEDIUM, true)) ?></td>
                    </tr>
                    <?php endif; ?>
                    <?php if ($quoteExtension->getExpiresAt()): ?>
                    <tr>
                        <th><?= $block->escapeHtml(__('Expires At')) ?></th>
                        <td>
                            <?php
                            $expiresAt = new \DateTime($quoteExtension->getExpiresAt());
                            $now = new \DateTime();
                            if ($expiresAt < $now): ?>
                                <span class="grid-severity-critical">
                                    <?= $block->escapeHtml($block->formatDate($quoteExtension->getExpiresAt(), \IntlDateFormatter::MEDIUM, true)) ?> <strong>(<?= $block->escapeHtml(__('Expired')) ?>)</strong>
                                </span>
                            <?php else: ?>
                                <?= $block->escapeHtml($block->formatDate($quoteExtension->getExpiresAt(), \IntlDateFormatter::MEDIUM, true)) ?>
                            <?php endif; ?>
                        </td>
                    </tr>
                    <?php endif; ?>
                    <tr>
                        <th><?= $block->escapeHtml(__('Created At')) ?></th>
                        <td><?= $block->escapeHtml($block->formatDate($quoteExtension->getCreatedAt(), \IntlDateFormatter::MEDIUM, true)) ?></td>
                    </tr>
                    <tr>
                        <th><?= $block->escapeHtml(__('Updated At')) ?></th>
                        <td><?= $block->escapeHtml($block->formatDate($quoteExtension->getUpdatedAt(), \IntlDateFormatter::MEDIUM, true)) ?></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<?php if ($customer): ?>
<div class="admin__page-section">
    <div class="admin__page-section-title">
        <span class="title"><?= $block->escapeHtml(__('Customer Information')) ?></span>
    </div>
    <div class="admin__page-section-content">
        <div class="admin__page-section-item customer-information">
            <div class="admin__page-section-item-content">
                <table class="admin__table-secondary">
                    <tr>
                        <th><?= $block->escapeHtml(__('Customer ID')) ?></th>
                        <td><?= $block->escapeHtml($customer->getId()) ?></td>
                    </tr>
                    <tr>
                        <th><?= $block->escapeHtml(__('Name')) ?></th>
                        <td><?= $block->escapeHtml($customer->getFirstname() . ' ' . $customer->getLastname()) ?></td>
                    </tr>
                    <tr>
                        <th><?= $block->escapeHtml(__('Email')) ?></th>
                        <td>
                            <a href="mailto:<?= $block->escapeHtmlAttr($customer->getEmail()) ?>">
                                <?= $block->escapeHtml($customer->getEmail()) ?>
                            </a>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
<?php endif; ?>

<?php if ($quote): ?>
<?php $quote->collectTotals(); ?>
<div class="admin__page-section">



<?php if ($quote->getAllItems()): ?>
<div class="admin__page-section">
    <div class="admin__page-section-title">
        <span class="title"><?= $block->escapeHtml(__('Quote Items')) ?></span>
    </div>
    <div class="admin__page-section-content">
        <div class="admin__page-section-item quote-items">
            <div class="admin__page-section-item-content">
                <div class="admin__data-grid-wrap admin__data-grid-wrap-static">
                    <table class="admin__data-grid-table">
                        <thead>
                            <tr class="data-grid-tr">
                                <th class="data-grid-th"><?= $block->escapeHtml(__('Product')) ?></th>
                                <th class="data-grid-th"><?= $block->escapeHtml(__('SKU')) ?></th>
                                <th class="data-grid-th"><?= $block->escapeHtml(__('Price')) ?></th>
                                <th class="data-grid-th"><?= $block->escapeHtml(__('Qty')) ?></th>
                                <th class="data-grid-th"><?= $block->escapeHtml(__('Subtotal')) ?></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php 
                            $items = $quote->getAllItems();
                            $totalSubtotal = 0;
                            ?>
                            <?php if ($items && count($items) > 0): ?>
                                <?php foreach ($items as $item): ?>
                                <?php 
                                    $qty = is_numeric($item->getQty()) ? (float)$item->getQty() : 0;
                                    $price = is_numeric($item->getPrice()) ? (float)$item->getPrice() : 0;
                                    $rowTotal = is_numeric($item->getRowTotal()) ? (float)$item->getRowTotal() : null;
                                    $itemSubtotal = $rowTotal !== null ? $rowTotal : ($price * $qty);
                                    $totalSubtotal += $itemSubtotal;
                                ?>
                                <tr class="data-grid-tr">
                                    <td class="data-grid-td">
                                        <?= $block->escapeHtml($item->getName() ?: __('Unknown Product')) ?>
                                        <?php if ($item->getProductType()): ?>
                                            <br><small><?= $block->escapeHtml(__('Type: %1', $item->getProductType())) ?></small>
                                        <?php endif; ?>
                                    </td>
                                    <td class="data-grid-td"><?= $block->escapeHtml($item->getSku() ?: __('N/A')) ?></td>
                                    <td class="data-grid-td"><?= $item->getPrice() !== null ? $block->formatCurrency($item->getPrice()) : __('N/A') ?></td>
                                    <td class="data-grid-td"><?= $block->escapeHtml($qty) ?></td>
                                    <td class="data-grid-td">
                                        <strong><?= $itemSubtotal !== null ? $block->formatCurrency($itemSubtotal) : __('N/A') ?></strong>
                                    </td>
                                </tr>
                                <?php endforeach; ?>
                                <tr class="data-grid-tr" style="border-top: 2px solid #ccc; background: #f5f5f5;">
                                    <td colspan="4" class="data-grid-td" style="text-align: right; font-weight: bold;">
                                        <?= $block->escapeHtml(__('Total Subtotal (Calculated):')) ?>
                                    </td>
                                    <td class="data-grid-td" style="font-weight: bold;">
                                        <strong><?= $block->formatCurrency($totalSubtotal) ?></strong>
                                    </td>
                                </tr>
                            <?php else: ?>
                                <tr class="data-grid-tr">
                                    <td colspan="5" class="data-grid-td" style="text-align: center; padding: 2rem;">
                                        <em><?= $block->escapeHtml(__('No items found in this quote.')) ?></em>
                                    </td>
                                </tr>
                            <?php endif; ?>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<?php endif; ?>
<?php endif; ?>

<?php if ($quoteExtension->getNotes()): ?>
<div class="admin__page-section">
    <div class="admin__page-section-title">
        <span class="title"><?= $block->escapeHtml(__('Notes')) ?></span>
    </div>
    <div class="admin__page-section-content">
        <div class="admin__page-section-item notes">
            <div class="admin__page-section-item-content">
                <div class="admin__control-textarea">
                    <?= $block->escapeHtml($quoteExtension->getNotes()) ?>
                </div>
            </div>
        </div>
    </div>
</div>
<?php endif; ?>

<!-- Debug Information (Development Only) -->
<?php if ($block->getRequest()->getParam('debug')): ?>
<div class="admin__page-section">
    <div class="admin__page-section-title">
        <span class="title"><?= $block->escapeHtml(__('Debug Information')) ?></span>
        <small style="color: #666;">(Add ?debug=1 to URL to see this section)</small>
    </div>
    <div class="admin__page-section-content">
        <div class="admin__page-section-item">
            <div class="admin__page-section-item-content">
                <table class="admin__table-secondary">
                    <tr>
                        <th><?= $block->escapeHtml(__('Quote Extension Data')) ?></th>
                        <td><pre style="font-size: 11px; max-height: 200px; overflow: auto;"><?= $block->escapeHtml(print_r($quoteExtension->getData(), true)) ?></pre></td>
                    </tr>
                    <?php if ($quote): ?>
                    <tr>
                        <th><?= $block->escapeHtml(__('Quote Data')) ?></th>
                        <td><pre style="font-size: 11px; max-height: 200px; overflow: auto;"><?= $block->escapeHtml(print_r($quote->getData(), true)) ?></pre></td>
                    </tr>
                    <tr>
                        <th><?= $block->escapeHtml(__('Quote Items')) ?></th>
                        <td>
                            <?php if ($quote->getAllItems()): ?>
                                <?php foreach ($quote->getAllItems() as $i => $item): ?>
                                    <strong>Item <?= $i + 1 ?>:</strong>
                                    <pre style="font-size: 10px; max-height: 150px; overflow: auto;"><?= $block->escapeHtml(print_r($item->getData(), true)) ?></pre>
                                <?php endforeach; ?>
                            <?php else: ?>
                                <em>No items found</em>
                            <?php endif; ?>
                        </td>
                    </tr>
                    <?php endif; ?>
                </table>
            </div>
        </div>
    </div>
</div>
<?php endif; ?>


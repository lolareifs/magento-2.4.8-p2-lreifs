								},
								{
									"key": "date_to",
									"value": "",
									"description": "Filter to date (YYYY-MM-DD format, optional)",
									"disabled": true
								}
							]
						},
						"description": "Get all immutable quotes in the system with advanced filtering options. Admin-only endpoint with pagination and sorting capabilities."
					},
					"response": []
				}
			],
			"description": "Endpoints for retrieving quote information - individual quotes, customer quotes, and system-wide admin queries"
		},

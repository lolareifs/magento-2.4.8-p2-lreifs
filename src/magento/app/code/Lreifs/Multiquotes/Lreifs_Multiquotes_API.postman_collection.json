{
	"info": {
		"_postman_id": "lreifs-multiquotes-api",
		"name": "Lreifs Multiquotes API - Complete v1.0.0",
		"description": "Complete API collection for Lreifs Multiquotes module - Immutable quote system for Magento 2. ✅ INITIAL RELEASE v1.0.0: Enterprise-grade implementation with 9 endpoints, advanced filtering, system-wide admin access, comprehensive audit logging. Features: Create quotes with products, Convert existing quotes, Manage status, Complete CRUD operations, Admin system-wide access. Note: Admin user needs proper ACL permissions (Lreifs_Multiquotes::quote_extension_create).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "lreifs-dev"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{admin_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://local.magento",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "customer_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "customer_email",
			"value": "Lolareifscarmona+11@gmail.com",
			"type": "string"
		},
		{
			"key": "quote_id",
			"value": "7",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "🔐 Authentication",
			"item": [
				{
					"name": "Get Admin Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const token = pm.response.text().replace(/\"/g, '');",
									"    pm.collectionVariables.set('admin_token', token);",
									"    console.log('Admin token saved:', token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"lola123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/rest/V1/integration/admin/token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"rest",
								"V1",
								"integration",
								"admin",
								"token"
							]
						},
						"description": "Get admin authentication token for API access"
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for getting access tokens"
		},
		{
			"name": "📝 Create Quotes",
			"item": [
				{
					"name": "Create Immutable Quote",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"request\": {\n        \"customer_email\": \"{{customer_email}}\",\n        \"name\": \"Multi-Item Quote\",\n        \"description\": \"Quote with multiple products\",\n        \"notes\": \"Quote created with specific items using enhanced interface\",\n        \"customer_reference\": \"API-MULTI-ITEMS-{{$timestamp}}\",\n        \"custom_fee\": 15.50,\n        \"metadata\": {\n            \"priority\": \"high\",\n            \"source\": \"postman_api\",\n            \"special_handling\": true\n        },\n        \"items\": [\n            {\n                \"sku\": \"lreifs-test-product-001\",\n                \"qty\": 2,\n                \"price\": 99.99,\n                \"custom_price\": true\n            },\n            {\n                \"sku\": \"lreifs-test-product-002\",\n                \"qty\": 1,\n                \"price\": 149.50,\n                \"custom_price\": true\n            }\n        ]\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/rest/V1/lreifs-multiquotes/create-quote",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"rest",
								"V1",
								"lreifs-multiquotes",
								"create-quote"
							]
						},
						"description": "Create immutable quote with products. Supports both customer_id and customer_email. Enhanced with complete metadata and custom fees."
					},
					"response": []
				}
			],
			"description": "Endpoint for creating NEW immutable quotes with products"
		},
		{
			"name": "🔄 Convert Existing Quotes",
			"item": [
				{
					"name": "Convert Existing Quote to Immutable",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"request\": {\n        \"customer_id\": {{customer_id}},\n        \"name\": \"Converted Quote\",\n        \"description\": \"Existing quote converted to immutable\",\n        \"notes\": \"This converts an existing quote (ID {{quote_id}}) to immutable\",\n        \"customer_reference\": \"CONVERTED-QUOTE-{{quote_id}}\",\n        \"custom_fee\": 25.00,\n        \"metadata\": {\n            \"conversion_type\": \"manual\",\n            \"source\": \"postman_api\",\n            \"original_quote_id\": {{quote_id}}\n        }\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/rest/V1/lreifs-multiquotes/quotes/{{quote_id}}/convert",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"rest",
								"V1",
								"lreifs-multiquotes",
								"quotes",
								"{{quote_id}}",
								"convert"
							]
						},
						"description": "Convert an existing quote (with existing quote_id) to immutable"
					},
					"response": []
				}
			],
			"description": "Endpoints for converting existing quotes to immutable"
		},
